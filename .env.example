# Klog Dashboard Configuration

# Directory containing your .klg, .klog, or .txt files
# Defaults to ./data if not set
KLOG_DATA_DIR=./data

# Daily work hours target for "Should vs Actual" calculations
# Defaults to 8.0 if not set. Provides the default; adjustable in the UI.
KLOG_DAILY_TARGET_HOURS=8.0

# Comma-separated working weekdays (entries outside these days have a 0h target
# unless an explicit should-total like (4h!) is set on the day).
# Accepts mon,tue,wed,thu,fri,sat,sun or 0-6 (0=Sun). Defaults to mon,tue,wed,thu,fri.
KLOG_WORKING_DAYS=mon,tue,wed,thu,fri

# Comma-separated tag names to exclude from ALL calculations and charts
# (e.g. vacation days, sick leave, holidays). Leading '#' is optional.
# Provides the permanent default; it can still be adjusted in the UI.
# Example: KLOG_EXCLUDED_TAGS=vacation,sickleave,holiday
KLOG_EXCLUDED_TAGS=

# Comma-separated tag names counted as billable in the Billable vs Non-billable
# split. Leading '#' is optional. Provides the default; adjustable in the UI.
# When empty, the billable views are hidden entirely.
# Example: KLOG_BILLABLE_TAGS=billable,client
KLOG_BILLABLE_TAGS=

# Target billable percentage goal (0-100). Shown as a marker on the split bar
# with over/under status. 0 disables the goal. Adjustable in the UI.
# Example: KLOG_BILLABLE_TARGET_PERCENT=70
KLOG_BILLABLE_TARGET_PERCENT=0

# Annual paid vacation allowance in days (0 disables the Leave Balance tracker).
# Adjustable in Settings.
# Example: KLOG_VACATION_ALLOWANCE_DAYS=25
KLOG_VACATION_ALLOWANCE_DAYS=0

# Comma-separated tag names that count against the annual vacation allowance.
# Other active excluded tags (e.g. sickleave, holiday) are shown separately.
# Defaults to vacation. Adjustable in Settings.
KLOG_VACATION_TAGS=vacation

# Optional employment start date (YYYY-MM-DD). Prorates the vacation allowance
# for that year and counts vacation entries from that date onward.
# Example: KLOG_VACATION_START_DATE=2026-07-01
KLOG_VACATION_START_DATE=
