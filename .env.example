# Klog Dashboard Configuration

# Directory containing your .klg, .klog, or .txt files
# Defaults to ./data if not set
KLOG_DATA_DIR=./data

# Daily work hours target for "Should vs Actual" calculations
# Defaults to 8.0 if not set
KLOG_DAILY_TARGET_HOURS=8.0

# Comma-separated tag names to exclude from ALL calculations and charts
# (e.g. vacation days, sick leave, holidays). Leading '#' is optional.
# Provides the permanent default; it can still be adjusted in the UI.
# Example: KLOG_EXCLUDED_TAGS=vacation,sickleave,holiday
KLOG_EXCLUDED_TAGS=

# Comma-separated tag names counted as billable in the Billable vs Non-billable
# split. Leading '#' is optional. Provides the default; adjustable in the UI.
# When empty, the billable views are hidden entirely.
# Example: KLOG_BILLABLE_TAGS=billable,client
KLOG_BILLABLE_TAGS=

# Target billable percentage goal (0-100). Shown as a marker on the split bar
# with over/under status. 0 disables the goal. Adjustable in the UI.
# Example: KLOG_BILLABLE_TARGET_PERCENT=70
KLOG_BILLABLE_TARGET_PERCENT=0
